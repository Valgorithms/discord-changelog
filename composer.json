{
  "name": "valgorithms/discord-changelog",
  "description": "GitHub commits -> Discord webhook watcher",
  "license": "MIT",
  "authors": [
      {
          "name": "Valithor Obsidion",
          "email": "valithor@discordphp.org"
      }
  ],
  "require": {
    "php": ">=7.4",
    "monolog/monolog": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Valgorithms\\DiscordChangelog\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "friendsofphp/php-cs-fixer": "^3",
    "phpacker/phpacker": "^0.6.4"
  },
  "scripts": {
      "cs": "php-cs-fixer fix",
      "cs-unsupported": "php-cs-fixer fix --allow-unsupported-php-version yes",
      "unit": "phpunit tests --testdox",
      "phpacker": "phpacker build --src=run.php all"
  },
  "bin": ["bin/discord-changelog.php"]
}
